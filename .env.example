# Copia este archivo a .env en el servidor y ajusta los valores.

# Dominio principal del sitio (sin https://)
DOMAIN=skyeggs.pro

# Dominio alterno: él y los www redirigen (301) al principal
ALT_DOMAIN=huevosdelcielo.pro

# Imagen publicada por GitHub Actions (en minúsculas)
IMAGE=ghcr.io/josephrioshenao/skyeggspage:latest

# Red de Docker donde vive tu Traefik
TRAEFIK_NETWORK=traefik

# Nombre del entrypoint HTTPS y del certresolver de tu Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Solo si usas docker-compose.traefik.yml (Traefik incluido): correo para Let's Encrypt
ACME_EMAIL=tu-correo@ejemplo.com

# ---------- API de "Prueba tu suerte" ----------
# Imagen de la API publicada por GitHub Actions
API_IMAGE=ghcr.io/josephrioshenao/skyeggspage-api:latest

# Clave que comparte el juego con la API (mín. 32 caracteres). Genérala con:  openssl rand -hex 32
# El mismo valor va en Roblox: Creator Dashboard → la experiencia → Secrets, con el nombre SkyEggsWeb.
GAME_KEY=

# Login del panel https://skyeggs.pro/admin/
ADMIN_USER=joseph
# Hash de la contraseña (nunca la contraseña en claro). Genéralo con:
#   docker compose run --rm skyeggs-api node --disable-warning=ExperimentalWarning src/hash-password.js
ADMIN_PASSWORD_HASH=

# Premios que una cuenta puede cobrar por día (hora de Colombia)
MAX_MYTHIC_PER_DAY=5
MAX_LEGENDARY_PER_DAY=5
# Nivel mínimo en el juego para recibir los premios (0 = sin mínimo); mientras tanto quedan guardados
MIN_LEVEL=10
# Horas que dura un código sin canjear
CODE_TTL_HOURS=72

# ---------- Programa de creadores: login con Discord (DEPLOY.md §7) ----------
# Discord Developer Portal → tu aplicación → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# ID del servidor de Discord de Sky Eggs (clic derecho al servidor → Copiar ID, con el modo desarrollador activado)
DISCORD_GUILD_ID=
# Opcional: webhook de un canal de moderadores para avisar de solicitudes, evidencias y bonos
DISCORD_WEBHOOK_URL=
# Roles (ya vienen puestos)
DISCORD_ROLE_ADMIN=1560889139375898775
DISCORD_ROLE_MODERATOR=1563742282392543312
DISCORD_ROLE_CREATOR=1561051688125730897
# Días para reclamar después de que termina la semana / el mes
CLAIM_GRACE_DAYS_WEEK=3
CLAIM_GRACE_DAYS_MONTH=5

# ---------- Roles automáticos con el bot de Discord (opcional, DEPLOY.md §7) ----------
# Token del bot de la MISMA app de Discord (Bot → Reset Token). Con él, al aprobar una solicitud y en cada
# cambio de rango la página pone/quita los roles sola. Vacío = los moderadores los dan a mano.
DISCORD_BOT_TOKEN=
# Roles de cada rango (opcionales). Hoy hay UN solo rol para todos los niveles (DISCORD_ROLE_CREATOR):
# déjalos vacíos. Si algún día creas un rol por nivel, pon aquí sus IDs.
DISCORD_ROLE_CREATOR_ACTIVE=
DISCORD_ROLE_CREATOR_VIRAL=
DISCORD_ROLE_CREATOR_STAR=
DISCORD_ROLE_CREATOR_ELITE=

# ---------- Rangos automáticos y creadores antiguos ----------
# Suben con las vistas semanales (3k/3.5k/4.5k/5k) y bajan a Creator tras una semana sin videos.
CREATOR_AUTO_TIERS=true
# Aviso por el buzón N días antes de que termine la semana sin videos
CREATOR_WARN_DAYS_BEFORE=3
# Horas tras el domingo para subir la evidencia antes de aplicar la bajada
CREATOR_DEMOTION_GRACE_HOURS=24
# Creadores que ya tenían el rango en el juego: días para aplicar desde el aviso y fecha límite final
LEGACY_NOTICE_DAYS=3
LEGACY_DEADLINE=2027-01-01

# ---------- Programa de staff (DEPLOY.md §8) ----------
# Roles de Discord de cada rango (el bot los pone y quita; el de mayor rango también da permisos de moderador en el panel)
# Canal de anuncios del staff: el bot avisa ahí (solicitudes, videos, reportes…) y menciona al rango que toca
DISCORD_ANNOUNCE_CHANNEL=1565510042851999834
# Bot más completo (botones, anuncios de videos y alertas de huevos):
# Clave pública de la app (Developer Portal → General Information → Public Key). Pon también
# "Interactions Endpoint URL" = https://skyeggs.pro/api/discord/interactions para que funcionen los botones.
DISCORD_PUBLIC_KEY=
# Canal donde se anuncian los videos aprobados de los creadores y rol opcional para avisar (vacío = sin mención).
DISCORD_VIDEO_CHANNEL=1560771030228799510
DISCORD_ROLE_VIDEO_PING=
# Canal de alertas de huevos ABSURDOS (antes webhook del Worker) y rol @Egg Ping. Idioma del mensaje público.
DISCORD_EGG_CHANNEL=1567675436681662604
DISCORD_ROLE_EGG_PING=1567693893963612250
DISCORD_EGG_LANG=es
# Opcional: API key de Open Cloud de TU cuenta (no del grupo) con el permiso "Legacy Asset → legacy-asset:manage",
# restringida a la IP del VPS. Sirve para bajar las imágenes privadas del juego (íconos). Sin ella se usa la
# API pública de miniaturas (las imágenes privadas salen como "no disponible").
ROBLOX_API_KEY=
MEDIA_DIR=/data/media
DISCORD_ROLE_HELPER=1563735797444771961
DISCORD_ROLE_MODERATORJR=1563736116300087337
DISCORD_ROLE_STAFF_MODERATOR=1563736465522036736
# El staff que ya existía vincula Discord + Roblox antes de esta fecha; si no, pierde el rango (juego y Discord)
STAFF_LINK_DEADLINE=2026-12-01
# Meses seguidos sin cumplir las tareas para salir del staff (0 = nunca se quita solo)
STAFF_FAIL_MONTHS_TO_REMOVE=2
# Día del mes en que se avisa por el buzón a quien va por debajo del 50 %
STAFF_WARN_DAY=20
# Días después de fin de mes para subir evidencias del mes pasado antes de cerrarlo
STAFF_GRACE_DAYS=3

# ---------- Vistas automáticas de las evidencias (yt-dlp, sin claves) ----------
# YouTube, TikTok, Twitch y Kick se leen solos y se refrescan cada VIEWS_REFRESH_HOURS
# mientras el video cuente para algún reclamo. Instagram/Facebook: vistas fijas del moderador.
VIEWS_AUTO=true
VIEWS_REFRESH_HOURS=6
# YouTube no necesita claves: se leen las páginas públicas (/shorts y /watch) y, si YouTube bloquea
# al servidor ("confirm you're not a bot"), la API libre de Return YouTube Dislike.
# Opcional y casi nunca necesario: clave gratuita de la YouTube Data API v3 como respaldo extra.
YOUTUBE_API_KEY=

# Copia este archivo a .env en el servidor y ajusta los valores.

# Dominio principal del sitio (sin https://)
DOMAIN=skyeggs.pro

# Dominio alterno: él y los www redirigen (301) al principal
ALT_DOMAIN=huevosdelcielo.pro

# Imagen publicada por GitHub Actions (en minúsculas)
IMAGE=ghcr.io/josephrioshenao/skyeggspage:latest

# Red de Docker donde vive tu Traefik
TRAEFIK_NETWORK=traefik

# Nombre del entrypoint HTTPS y del certresolver de tu Traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Solo si usas docker-compose.traefik.yml (Traefik incluido): correo para Let's Encrypt
ACME_EMAIL=tu-correo@ejemplo.com
